# Project Umbra — Environment Configuration
# Copy this to .env and fill in your values

# ── AI Model Keys ────────────────────────────────────────────
# Required: Google Gemini API Key (get at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Primary Gemini model (default: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# Optional: classifier implementation. The verified default uses deterministic rules.
PII_CLASSIFIER_MODE=heuristic

# Used only when PII_CLASSIFIER_MODE=neural
GEMMA_MODEL=gemma-2-9b-it
GEMMA_LOCAL_PIPELINE=false

# ── Google Cloud (for Firestore persistence) ─────────────────
# Your GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id
# Firestore database name (usually "(default)")
FIRESTORE_DATABASE=(default)

# ── Persistence Mode ─────────────────────────────────────────
# "auto"      → Try Firestore, fall back to SQLite
# "firestore" → Force Firestore (requires GCP auth)
# "sqlite"    → Force local SQLite (no cloud required)
PERSISTENCE_MODE=auto
SQLITE_DB_PATH=data/project_umbra.db

# ── Server ───────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Production Access ────────────────────────────────────────
# Leave blank for local development. Generate and store real values privately
# through the deployment platform's secret manager.
UMBRA_OPERATOR_TOKEN=
UMBRA_ACCESS_SECRET=
MISSION_TOKEN_TTL_SECONDS=86400
# Comma-separated explicit browser origins; never use a credentialed wildcard.
CORS_ALLOWED_ORIGINS=

# ── Agent Execution ──────────────────────────────────────────
# Max number of reasoning steps before forcing termination (safety budget)
AGENT_MAX_STEP_BUDGET=25

# ── Playwright (Browser Scanning) ────────────────────────────
PLAYWRIGHT_HEADLESS=true
# Set to true to use deterministic fixture responses instead of live scraping
# Recommended for Cloud Run and CI environments
PLAYWRIGHT_SIMULATION_MODE=false
PLAYWRIGHT_TIMEOUT_MS=15000

# ── SERP Scanner ─────────────────────────────────────────────
# "auto"           → Infers best available method
# "duckduckgo_lite"→ DDG Lite (no API key required)
# "google_genai"   → Google Search Grounding via Gemini API
# "searxng"        → A separately configured SearXNG instance
# "mock"           → Deterministic fixture responses
SERP_MODE=auto
SEARXNG_URL=
SERP_MAX_CONCURRENCY=3
SERP_TIMEOUT_SECONDS=10.0
